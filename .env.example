# Public values. Update these with your Supabase details from your project
# settings > API: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only value. Never prefix this variable with NEXT_PUBLIC_.
# It is required by production startup for market-order ingestion.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional public analytics values (self-hosted Umami; see docs/umami.md).
# They are all-or-nothing: set both together or leave both unset. Unset (the
# local-development and test default) disables analytics entirely and makes
# no outbound requests. Setting only one is invalid and fails safe: analytics
# stays disabled, Flipper keeps serving, and validation names the variables
# only. Never store secrets here; both values are public browser
# configuration.
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://umami.mattiaswiberg.com/script.js
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-umami-website-id
