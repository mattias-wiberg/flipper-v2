# Public values. Update these with your Supabase details from your project
# settings > API: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only value. Never prefix this variable with NEXT_PUBLIC_.
# It is required by production startup for market-order ingestion.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
