{
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "local": "husky install && npm run db:start && npm run db:generate:types:local",
    "db:start": "supabase db start",
    "db:migrate": "supabase db diff | supabase migration new",
    "db:generate:types:local": "supabase gen types typescript --local > database.types.ts",
    "mock:order:ingest": "node --experimental-fetch ./mocker/sendOrders.js",
    "golden:orders": "node --experimental-fetch ./mocker/getOrders.js --compare",
    "sync:ao-dumps": "node --experimental-fetch utils/syncAoDumps.js",
    "format:items": "node utils/itemsFormatter.js",
    "format:world": "node utils/worldFormatter.js",
    "format:data": "npm run format:items && npm run format:world",
    "update:ao-data": "npm run sync:ao-dumps && npm run format:data",
    "debug:items-formatter": "node --inspect-brk utils/itemsFormatter.js",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-resizable-panels": "^4.13.0",
    "recharts": "3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@dokploy/cli": "^0.30.7",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "postcss": "^8.5.28",
    "supabase": "2.117.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
