{
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "local": "husky install && npm run db:start && npm run db:generate:types:local",
    "db:start": "supabase db start",
    "db:migrate": "supabase db diff | supabase migration new",
    "db:generate:types:local": "supabase gen types typescript --local > database.types.ts",
    "mock:order:ingest": "node --experimental-fetch ./mocker/sendOrders.js",
    "golden:orders": "node --experimental-fetch ./mocker/getOrders.js --compare",
    "sync:ao-dumps": "node --experimental-fetch utils/syncAoDumps.js",
    "format:items": "node utils/itemsFormatter.js",
    "format:world": "node utils/worldFormatter.js",
    "format:data": "npm run format:items && npm run format:world",
    "update:ao-data": "npm run sync:ao-dumps && npm run format:data",
    "debug:items-formatter": "node --inspect-brk utils/itemsFormatter.js"
  },
