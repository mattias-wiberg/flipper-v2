# Secrets for the Umami analytics stack (deploy/umami/docker-compose.yml).
#
# Provide these through the Dokploy Compose environment (or an untracked .env
# next to the compose file when running plain `docker compose`). Replace every
# placeholder with a strong unique value; `openssl rand -hex 32` is suitable
# for the first three. UMAMI_DB_PASSWORD must be URL-safe (hex) because it is
# embedded in DATABASE_URL without escaping. UMAMI_TWO_FACTOR_ENCRYPTION_KEY
# must be exactly 64 hex characters per Umami's documentation.
# Never commit real values; nothing in this file is a secret.
#
# UMAMI_BASIC_AUTH_USERS is the Traefik basic-auth user list for the dashboard
# router. Generate it with `htpasswd -nbB admin 'your-password'` and keep the
# resulting `admin:$2y$...` value only in the deploy environment. The tracker
# paths stay public because the compose file routes them separately.

UMAMI_DB_PASSWORD=replace-with-openssl-rand-hex-32
UMAMI_APP_SECRET=replace-with-openssl-rand-hex-32
UMAMI_TWO_FACTOR_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
UMAMI_BASIC_AUTH_USERS=replace-with-htpasswd-output
